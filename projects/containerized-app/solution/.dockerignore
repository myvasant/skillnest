# Everything listed here stays out of the build context: smaller, faster builds and no leaked secrets.

# Secrets and local configuration
.env
.env.*
*.pem
*.key

# Version control and editor files
.git/
.gitignore
.vscode/
.idea/

# Python byproducts and local environments
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Not needed inside the image
tests/
data/
*.log
Dockerfile
.dockerignore
compose.yaml
README.md
