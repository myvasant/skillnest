# Template for local configuration. Copy it to .env and replace every "change-me" value:
#   PowerShell:    Copy-Item .env.example .env
#   macOS/Linux:   cp .env.example .env
# .env is git-ignored. Never commit real secrets; in production inject them from a secrets manager.
# Real environment variables always win over values in .env.

# --- Settings with safe defaults (shown here so they are discoverable) ---
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_PUBLIC_BASE_URL=http://localhost:8000
APP_REQUEST_TIMEOUT_SECONDS=5

# --- Required secrets: placeholders only (production refuses any value containing "change-me") ---
# Generate strong values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_DATABASE_URL=postgresql://app:change-me@localhost:5432/app
APP_API_KEY=change-me-api-key-0000
APP_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-32
