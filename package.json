{
  "name": "groundwork",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first, zero-cost interactive learning platform: Python, software engineering, data, ML, GenAI, RAG and agentic AI.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pyodide.mjs",
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && vite preview --open",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "tsx scripts/validate-content.ts",
    "check:links": "tsx scripts/check-links.ts",
    "report:coverage": "tsx scripts/coverage-report.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:content": "vitest run tests/content",
    "test:e2e": "playwright test",
    "test:projects": "node scripts/test-projects.mjs",
    "lint:python": "node -e \"process.exit(require('child_process').spawnSync(require('fs').existsSync('.venv') ? (process.platform==='win32' ? '.venv/Scripts/python' : '.venv/bin/python') : 'python', ['-m','ruff','check','python','projects'],{stdio:'inherit'}).status)\"",
    "check": "npm run validate:content && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/python": "^1.1.19",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.61.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
